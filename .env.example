# ================================================================
# PickTiming 환경 변수 — .env 하나를 로컬 PC·EC2에서 쓰고, [Render] 표시 값은 Render 대시보드에도 등록한다.
# (.env는 Git에 올리지 않음)
#
#   표시 규칙
#     [공통]      로컬·EC2·Render 모두 같은 값 (Render: Environment → "Add from .env"로 붙여 넣기)
#     [Render]    Render에도 등록 (대부분 [공통]과 동일, Render에만 필요한 값은 따로 표기)
#     [EC2 전용]  EC2(docker compose)에서만 사용 — Render에는 넣지 않음
#     [선택]      값이 없으면 해당 기능만 꺼짐(나머지는 정상 동작)
#
#   사용 방법
#     1) 로컬 PC : copy .env.example .env → 값 채우기
#     2) EC2     : scp -i <키.pem> .env ubuntu@picktiming.duckdns.org:~/picktiming/.env
#     3) Render  : 아래 "Render 등록 목록"만 Environment에 붙여 넣기 (EC2 전용 블록은 빼고)
#     4) GitHub  : Secret RENDER_RPA_API_KEY = RPA_API_KEY 값 (Render 가격 수집용)
#
#   DB는 로컬 포함 모두 TiDB(운영 DB 하나)를 공유한다. pytest는 임시 SQLite라 안전하며,
#   python -m app.seed --reset 은 운영 데이터를 모두 지우므로 실행하지 않는다.
# ================================================================

# ================================================================
# [공통][Render] 필수 — 앱 실행에 꼭 필요
# ================================================================
# production이면 JWT_SECRET·RPA_API_KEY가 비어 있을 때 서버가 시작하지 않음
APP_ENV=production

# TiDB Cloud → Connect 화면의 HOST·USER와 Generate Password로 발급한 비밀번호
#   (특수문자는 URL 인코딩: python -c "import urllib.parse;print(urllib.parse.quote('비밀번호', safe=''))")
#   AWS RDS(MySQL)로 바꿀 때: mysql+pymysql://<USER>:<PASSWORD>@<RDS 엔드포인트>:3306/picktiming?charset=utf8mb4
#   DB 이름은 picktiming (이전 이름 buytiming의 테이블은 RENAME TABLE로 옮겼다 — docs/md/06-database.md 참고)
DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<HOST>:4000/picktiming?charset=utf8mb4

# TLS 인증서 경로. TiDB는 그대로 둔다(파일이 없는 Windows 로컬은 자동으로 certifi 사용).
#   AWS RDS는 AWS가 배포하는 global-bundle.pem 경로를 지정
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"  — 실행할 때마다 다른 값
JWT_SECRET=
# 수집기 전용 API 비밀번호 — GitHub Secret RENDER_RPA_API_KEY에도 같은 값
RPA_API_KEY=

# API 호출을 허용할 화면 주소(세 환경 공용)
ALLOWED_ORIGINS=https://picktiming.onrender.com,http://picktiming.duckdns.org,http://localhost:8000,http://localhost:5173

# ================================================================
# [공통][Render] 로그인
# ================================================================
# 로그인 화면의 "일반 사용자 / 관리자 테스트" 버튼 (시드 계정 사용). 시연이 끝나면 false 권장
DEMO_LOGIN_ENABLED=true
# 이 이메일로 새로 가입하면 관리자 (쉼표 구분)
ADMIN_EMAILS=

# [선택] 소셜 로그인 — 값이 있는 제공자만 버튼이 활성화된다.
#   각 개발자 콘솔에 콜백 주소(Redirect URI)를 환경별로 모두 등록한다:
#     https://picktiming.onrender.com/api/v1/auth/oauth/<google|naver|kakao>/callback
#     http://picktiming.duckdns.org/api/v1/auth/oauth/<google|naver|kakao>/callback
#     http://localhost:8000/api/v1/auth/oauth/<google|naver|kakao>/callback
# Google: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Naver: developers.naver.com → 애플리케이션 등록 → 네이버 로그인(이메일·이름 제공 동의)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Kakao: developers.kakao.com → 내 애플리케이션 → REST API 키 / 보안 → Client Secret(사용 시)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 콜백 주소의 기준 주소. 비우면 접속한 주소를 자동 사용(보통 비워 둠)
PUBLIC_BASE_URL=

# ================================================================
# [공통][Render] AI
# ================================================================
# [선택] Google AI Studio API 키. 비우면 AI 조언이 규칙 기반 템플릿 문장으로 동작
GEMINI_API_KEY=

# ================================================================
# [공통][Render] 시드 데이터 (python -m app.seed 실행 시만 사용)
# ================================================================
# 테스트 계정 비밀번호(demo@picktiming.demo / admin@picktiming.demo). 비우면 무작위 생성 후 출력
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=

# ================================================================
# [EC2 전용] RPA 가격 수집기 (EC2의 rpa 컨테이너) — Render에는 넣지 않음
#   Render 쪽 수집은 GitHub Actions(collect-render.yml)가 하며, 같은 값을 GitHub에 따로 등록한다:
#   NAVER_SEARCH_* → Secret 같은 이름, KCA_API_URL → Variable, DATA_GO_KR_KEY → Secret
# ================================================================
# [선택] 네이버 쇼핑 검색 OpenAPI — developers.naver.com → 애플리케이션 등록 → 사용 API "검색"
#   값이 있으면 모든 상품에 '네이버쇼핑' 판매처를 만들고 매시 실제 최저가를 수집
#   (네이버 로그인용 NAVER_CLIENT_*와 같은 애플리케이션이면 같은 값을 써도 됨)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# [선택] 공공데이터포털(data.go.kr) 한국소비자원 참가격 API 요청 주소와 일반 인증키(Decoding)
KCA_API_URL=
DATA_GO_KR_KEY=

# [선택] AWS S3 — 값이 있으면 수집 원본(JSON)과 주간 리포트(엑셀)를 업로드
#   인증: EC2에 S3 권한이 있는 IAM 역할을 연결하면 키 없이 동작(권장). 역할이 없을 때만 아래 키 입력
S3_BUCKET=
S3_PREFIX=picktiming
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ================================================================
# 기본값이 있어 보통 넣지 않는 값 (필요할 때만 주석 해제)
# ================================================================
# GEMINI_MODEL=gemini-2.5-flash
# AI_DAILY_LIMIT=20
# JWT_EXPIRE_MINUTES=60
# TZ=Asia/Seoul
# REQUEST_INTERVAL_SEC=3
# SIMULATE_MALLS=true
# RPA_TARGET_API — 넣지 않으면 EC2(compose)는 http://api:8000, 로컬 수집기는 http://localhost:8000
# FRONTEND_DIR   — 넣지 않으면 로컬은 frontend/dist 자동 사용, Render는 Dockerfile 값(/app/frontend). Render에 넣지 말 것
