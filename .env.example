# ================================================================
# BuyTiming 환경 변수 — .env 하나를 로컬 PC·EC2·Render에서 똑같이 쓴다. (.env는 Git에 올리지 않음)
#
#   1) 로컬 PC : copy .env.example .env → 값 채우기 → 그대로 사용
#   2) EC2     : 같은 .env를 서버로 복사
#                scp -i <키.pem> .env ubuntu@buytiming.duckdns.org:~/buytiming/.env
#   3) Render  : 대시보드 → Environment → "Add from .env" → 같은 .env 내용을 붙여 넣기
#   4) GitHub  : Secret RENDER_RPA_API_KEY = 아래 RPA_API_KEY 값 (Render 가격 수집용)
#
#   DB는 로컬 포함 모두 TiDB(운영 DB 하나)를 공유한다.
#   - pytest는 이 값을 쓰지 않고 임시 SQLite로 실행되므로 안전하다.
#   - python -m app.seed --reset 은 운영 데이터를 모두 지우므로 실행하지 않는다.
#   자세한 절차: docs/md/06-database.md(TiDB), 07(Render), 08(EC2)
# ================================================================

# production이면 JWT_SECRET·RPA_API_KEY가 비어 있을 때 서버가 시작하지 않음
APP_ENV=production

# TiDB Cloud → 인스턴스 → Connect 화면의 HOST·USER와 Generate Password로 발급한 비밀번호
#   (비밀번호의 특수문자는 URL 인코딩: python -c "import urllib.parse;print(urllib.parse.quote('비밀번호', safe=''))")
DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<HOST>:4000/buytiming?charset=utf8mb4

# 값이 있으면 TLS로 접속(TiDB 필수). 이 경로가 없는 환경(Windows 로컬)은 자동으로 certifi 인증서를 사용하므로 그대로 둔다
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"  — 두 번 실행해 각각 입력
#   JWT_SECRET  : 로그인 토큰 서명 키
#   RPA_API_KEY : 수집기 전용 API 비밀번호 (GitHub Secret RENDER_RPA_API_KEY에도 같은 값)
JWT_SECRET=
RPA_API_KEY=

# API 호출을 허용할 화면 주소. 세 환경 모두 화면과 API가 같은 도메인이라 하나의 값으로 공용
ALLOWED_ORIGINS=https://buytiming.onrender.com,http://buytiming.duckdns.org,http://localhost:8000

# ---------------- [선택] ----------------
# 이 이메일로 새로 가입하면 관리자 (쉼표 구분)
ADMIN_EMAILS=
# Google AI Studio API 키. 비우면 AI 조언이 규칙 기반 템플릿 문장으로 동작
GEMINI_API_KEY=
# 공공데이터포털(data.go.kr) 한국소비자원 참가격 API의 요청 주소와 일반 인증키(Decoding). 비우면 건너뜀
KCA_API_URL=
DATA_GO_KR_KEY=
# 시드(python -m app.seed) 데모·관리자 계정 비밀번호. 비우면 무작위 생성 후 출력
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=

# 기본값이 있어 넣지 않는 값:
#   GEMINI_MODEL=gemini-2.5-flash  AI_DAILY_LIMIT=20  JWT_EXPIRE_MINUTES=60  TZ=Asia/Seoul
#   REQUEST_INTERVAL_SEC=3  SIMULATE_MALLS=true
#   RPA_TARGET_API — 넣지 않으면 EC2(compose)는 http://api:8000, 로컬 수집기는 http://localhost:8000을 사용
#   FRONTEND_DIR   — 넣지 않으면 로컬은 저장소의 frontend/를 자동으로 서빙, Render는 Dockerfile 값(/app/frontend) 사용
