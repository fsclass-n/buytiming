# ================================================================
# BuyTiming 환경 변수 — 복사해서 .env로 저장 후 값을 채우세요. (.env는 Git에 올리지 않음)
#
#   어디서 읽나?
#     로컬 PC       : cp .env.example .env → 그대로 실행 가능(SQLite). JWT_SECRET·RPA_API_KEY만 아무 값이나 입력
#     EC2           : deploy/ec2-setup.sh가 이 파일을 .env로 복사 → [필수] 6개를 운영 값으로 변경
#     Render        : 이 파일을 읽지 않음 → 대시보드 Environment에 [필수] 6개를 같은 이름으로 입력
#     GitHub Actions: 이 파일을 읽지 않음 → Settings → Secrets and variables → Actions (docs/md/10 참고)
#
#   자세한 절차: docs/md/06-database.md(TiDB), 07(Render), 08(EC2)
# ================================================================

# ---------------- [필수] 6개 — Render 환경 변수와 같은 이름 ----------------
# development | production  (production이면 JWT_SECRET·RPA_API_KEY가 비어 있을 때 서버가 시작하지 않음)
APP_ENV=development

# 로컬: sqlite:///./buytiming.db
# 운영(TiDB, Render·EC2 공용): mysql+pymysql://<USER>:<PASSWORD>@<HOST>:4000/buytiming?charset=utf8mb4
#   (비밀번호의 특수문자는 URL 인코딩: python -c "import urllib.parse;print(urllib.parse.quote('비밀번호', safe=''))")
DATABASE_URL=sqlite:///./buytiming.db

# TiDB일 때만 입력: /etc/ssl/certs/ca-certificates.crt   (로컬 SQLite·MySQL은 비움)
DB_SSL_CA=

# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"  — 두 번 실행해 각각 입력
# JWT_SECRET  : 로그인 토큰 서명 키
# RPA_API_KEY : 수집기 전용 API 비밀번호 (EC2는 api·rpa가 이 파일을 함께 읽어 자동 일치)
JWT_SECRET=
RPA_API_KEY=

# 이 서버 화면의 주소 (화면과 API가 같은 도메인이라 자기 주소만 허용)
#   EC2: http://buytiming.duckdns.org   /   Render: https://buytiming.onrender.com   /   로컬: *
ALLOWED_ORIGINS=*

# ---------------- [선택] ----------------
# 이 이메일로 가입하면 관리자 (쉼표 구분)
ADMIN_EMAILS=
# 비우면 AI 조언이 규칙 기반 템플릿 문장으로 동작
GEMINI_API_KEY=
# 한국소비자원 참가격 공공데이터 (RPA public 작업, 비우면 건너뜀)
KCA_API_URL=
DATA_GO_KR_KEY=
# 시드(python -m app.seed) 데모·관리자 계정 비밀번호 (비우면 무작위 생성 후 출력)
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=

# 기본값이 있어 보통 넣지 않는 값:
#   GEMINI_MODEL=gemini-2.5-flash  AI_DAILY_LIMIT=20  JWT_EXPIRE_MINUTES=60  TZ=Asia/Seoul
#   REQUEST_INTERVAL_SEC=3  SIMULATE_MALLS=true
#   RPA_TARGET_API — 비워 두면 docker compose(EC2)는 http://api:8000, 로컬 수집기는 http://localhost:8000
#                    (localhost를 적으면 EC2 수집기가 API를 찾지 못하므로 EC2에서는 넣지 않음)

# ---------------- [docker compose] ----------------
# compose는 localdb 프로필을 쓰지 않아도 이 두 값이 비어 있으면 시작하지 않음.
# EC2(TiDB 사용)에서는 쓰이지 않으므로 그대로 두고, 로컬에서 --profile localdb로 MySQL 8을 쓸 때만 바꿔서 사용.
MYSQL_PASSWORD=change-me-local-mysql
MYSQL_ROOT_PASSWORD=change-me-local-mysql-root
