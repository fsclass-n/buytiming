# ================================================================
# BuyTiming 환경 변수 예시 — 복사해서 .env로 저장 후 값을 채우세요. (.env는 Git에 올리지 않음)
#   로컬(.venv):     DATABASE_URL=sqlite:///./buytiming.db 로 바로 실행 가능
#   Docker(로컬DB):  docker compose --profile localdb up
#                    DATABASE_URL=mysql+pymysql://buytiming:<MYSQL_PASSWORD>@mysql:3306/buytiming
#   운영(TiDB):      DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<TiDB 호스트>:4000/buytiming
#                    DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# ================================================================

# --- 백엔드(FastAPI) ---
# production이면 JWT_SECRET·RPA_API_KEY가 기본값일 때 기동을 거부한다
APP_ENV=development
DATABASE_URL=sqlite:///./buytiming.db
DB_SSL_CA=
# 생성 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# 쉼표 구분, 가입 시 관리자 권한 부여
ADMIN_EMAILS=
# 운영: https://<사이트>.netlify.app (쉼표 구분)
ALLOWED_ORIGINS=*
TZ=Asia/Seoul

# --- Google Gemini (키를 비우면 규칙 기반 템플릿으로 동작) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=20

# --- RPA ↔ API 공용 인증 키 (백엔드와 RPA 수집기가 같은 값을 사용) ---
RPA_API_KEY=

# --- RPA 수집기 ---
# docker compose에서는 기본값 http://api:8000, Render API 대상이면 https://<서비스>.onrender.com
RPA_TARGET_API=http://localhost:8000
REQUEST_INTERVAL_SEC=3
# *.example.com 시연 쇼핑몰은 모의 가격을 생성한다
SIMULATE_MALLS=true
# 공공데이터포털에서 발급받은 한국소비자원 참가격 API 엔드포인트와 서비스 키
KCA_API_URL=
DATA_GO_KR_KEY=

# --- 시드(python -m app.seed) 데모 계정 비밀번호 (비우면 무작위 생성 후 출력) ---
SEED_DEMO_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- docker compose --profile localdb 사용 시 ---
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
